// use prisma-8
enum UserRole {
  CUSTOMER
  CINEMA_ADMIN
  PLATFORM_ADMIN
}

enum Classification {
  L
  AGE_10
  AGE_12
  AGE_14
  AGE_16
  AGE_18
}

enum RoomType {
  STANDARD
  VIP
}

enum SeatType {
  STANDARD
  VIP
  ACCESSIBLE
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum TicketType {
  FULL
  HALF
}

model User {
  id           Int                        @id @default(autoincrement())
  name         String
  email        String                     @unique
  phone        String?
  passwordHash String
  role         UserRole                   @default(CUSTOMER)

  orders       Order[]
  cinemaAdmins CinemaAdmin[]

  createdAt    TimestamptzString          @default(now())
  updatedAt    temporal.updatedAtString()
}

model Cinema {
  id        Int                        @id @default(autoincrement())
  name      String
  address   String
  city      String
  state     String

  admins    CinemaAdmin[]
  rooms     Room[]

  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()
}

model CinemaAdmin {
  cinema    Cinema            @relation(fields:[cinemaId], references:[id])
  cinemaId  Int

  user      User              @relation(fields:[userId], references:[id])
  userId    Int

  createdAt TimestamptzString @default(now())

  @@id([cinemaId, userId])
}

model Room {
  id        Int                        @id @default(autoincrement())
  number    Int
  type      RoomType

  cinema    Cinema                     @relation(fields:[cinemaId], references:[id])
  cinemaId  Int

  seats     Seat[]
  sessions  Session[]

  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([cinemaId, number])
}

model Seat {
  id        Int                        @id @default(autoincrement())
  row       String
  number    Int
  type      SeatType

  room      Room                       @relation(fields:[roomId], references:[id])
  roomId    Int

  tickets   Ticket[]

  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([roomId, row, number])
}

model Movie {
  id             Int                        @id @default(autoincrement())
  title          String
  description    String?
  duration       Int
  classification Classification
  coverUrl       String?
  trailerUrl     String?

  sessions       Session[]

  createdAt      TimestamptzString          @default(now())
  updatedAt      temporal.updatedAtString()
}

model Session {
  id        Int                        @id @default(autoincrement())

  movie     Movie                      @relation(fields:[movieId], references:[id])
  movieId   Int

  room      Room                       @relation(fields:[roomId], references:[id])
  roomId    Int

  startsAt  TimestamptzString
  endsAt    TimestamptzString

  tickets   Ticket[]

  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()

  @@index([movieId, startsAt])
  @@index([roomId, startsAt])
}

model Order {
  id        Int                        @id @default(autoincrement())

  user      User                       @relation(fields:[userId], references:[id])
  userId    Int

  status    OrderStatus                @default(PENDING)
  total     Decimal

  tickets   Ticket[]

  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()
}

model Ticket {
  id        Int                        @id @default(autoincrement())

  order     Order                      @relation(fields:[orderId], references:[id])
  orderId   Int

  session   Session                    @relation(fields:[sessionId], references:[id])
  sessionId Int

  seat      Seat                       @relation(fields:[seatId], references:[id])
  seatId    Int

  type      TicketType
  price     Decimal
  code      String                     @unique

  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([sessionId, seatId])
}
